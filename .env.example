# ESPN Fantasy Basketball
# Get your league ID from the URL: https://fantasy.espn.com/basketball/league?leagueId=XXXXXX
ESPN_LEAGUE_ID=your_league_id_here

# ESPN season year (2026 = the 2025-26 season)
ESPN_SEASON_ID=2026

# Recommended auth: the ENTIRE cookie header from a logged-in fantasy.espn.com
# request. Copy it from Chrome DevTools > Network tab > any lm-api-reads request
# > Request Headers > cookie. Takes priority over ESPN_S2/ESPN_SWID below.
ESPN_COOKIE_STRING=

# Fallback auth: individual cookies (may not be enough on their own if ESPN
# requires additional cookies). Found in browser Application > Cookies >
# fantasy.espn.com
ESPN_S2=your_espn_s2_cookie_here

# SWID cookie (looks like {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX})
ESPN_SWID={your_swid_cookie_here}

# Neon Postgres connection string for league draft/keeper state.
# Optional locally — when unset, the server falls back to a JSON file at
# .data/league-state.json. Set it in production (Vercel) for persistence.
DATABASE_URL=
